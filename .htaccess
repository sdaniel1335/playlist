# 850 MiB: one 700 MiB video plus eleven images and multipart overhead.
LimitRequestBody 891289600

<Files ".user.ini">
  Require all denied
</Files>

RewriteEngine On

RewriteCond %{THE_REQUEST} \s/+(.*/)?public_html(?:/|\s|\?) [NC]
RewriteRule ^ - [R=404,L]
RewriteRule ^public_html(?:/|$) - [L]
RewriteRule ^index\.php$ - [L]
RewriteRule ^$ public_html/index.php [L,QSA]

RewriteRule ^(.*)$ public_html/$1 [L]
